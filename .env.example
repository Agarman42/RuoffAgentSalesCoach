# Copy this file to .env (never commit the real .env)
# Used by proxy.js as a fallback if no key is sent from the browser.
# On Render, set GROK_API_KEY / XAI_API_KEY in the dashboard.

GROK_API_KEY=xai-yourkeyhere
# XAI_API_KEY=xai-yourkeyhere

# Optional: change default port
# PORT=3000

# --- LO partner brand plate (read public LO cards) ---
# Base URL of the LO Sales Coach app that hosts GET /api/partner/:token
# Local default (in index.html script): http://localhost:3000
# Production: set in Render as a build-time note OR paste into index.html meta:
#   <meta name="lo-partner-api" content="https://your-lo-app.onrender.com">
# LO_PARTNER_API_BASE is read from that meta / window.LO_PARTNER_API_BASE (frontend).
